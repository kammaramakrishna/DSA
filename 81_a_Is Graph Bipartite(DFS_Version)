81_a_785. Is Graph Bipartite(DFS_Version)

class Solution:
    def dfs(self, node, col, color, graph):
        color[node] = col
        for i in graph[node]:
            if color[i] == -1:
                if self.dfs(i, not col, color, graph) == False:
                    return False
            elif color[i] == col:
                return False
        return True


    def isBipartite(self, graph: List[List[int]]) -> bool:
        v = len(graph)
        color = [-1] * v
        for i in range(v):
            color[i] = -1
        
        for i in range(v):
            if color[i] == -1:
                if self.dfs(i, 0, color, graph) == False:
                    return False
        return True


