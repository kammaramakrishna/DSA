83_a_802. Find Eventual Safe States (Khan's - BFS)

#BFS Version using Topological Sort
class Solution:
    def eventualSafeNodes(self, graph: List[List[int]]) -> List[int]:
        V = len(graph)
        adjRev = [[] for _ in range(V)]
        indegree = [0]*V
        #this is for reverse the links
        for i in range(V):
            for j in graph[i]:
                adjRev[j].append(i)
                indegree[i] += 1
        
        from collections import deque
        q = deque()
        safeNode = []

        #identify the terminal nodes
        for i in range(V):
            if indegree[i] == 0:
                q.append(i)

        
        while q:
            node = q.popleft()
            safeNode.append(node)
            for i in adjRev[node]:
                #reduce the indegree
                indegree[i] -= 1
                #if it is 0 indegree then add it
                if indegree[i] == 0:
                    q.append(i)

        safeNode.sort()
        return safeNode
        




