72_438. Find All Anagrams in a String

class Solution:
    def findAnagrams(self, s: str, p: str) -> List[int]:
        n = len(s)
        k = len(p)
        res = []
        if k > n:
            return []
        
        from collections import Counter
        p_count = Counter(p)
        window_count = Counter()
        
        for i in range(n):
            #add right most element
            window_count[s[i]] += 1 

            #if out of window then remove left most element
            #else add it
            if i >= k:
                if window_count[s[i-k]] == 1:
                    del window_count[s[i-k]]
                else:
                    window_count[s[i-k]] -= 1
            
            if window_count == p_count:
                res.append(i-k+1)
        return res





