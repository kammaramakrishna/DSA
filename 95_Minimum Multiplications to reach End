95_Minimum Multiplications to reach End

class Solution:
    def minimumMultiplications(self, arr, start, end):
        # code here
        from collections import deque
        
        q = deque()
        q.append((start, 0))
        dist = [float('inf')] * 100000
        dist[start] = 0
        
        while q:
            node, steps = q.popleft()
            for i in arr:
                num = (i * node) % 100000
                if (steps + 1) < dist[num]:
                    dist[num] = steps + 1
                    if num == end:
                        return steps + 1
                    q.append((num, (steps + 1)))
        return -1

