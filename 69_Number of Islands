    def numIslands(self, grid: List[List[str]]) -> int:
        n = len(grid)
        m = len(grid[0])
        visited = [[0]*m for _ in range(n)]
        count = 0
        for row in range(n):
            for col in range(m):
                if not visited[row][col] and grid[row][col] == "1":
                    count += 1
                    self.bfs(row, col, visited, grid)
        return count 
        
