69_200. Number of Islands

class Solution:
    def bfs(self, row, col, visited, grid):
        visited[row][col] = 1
        n = len(grid)
        m = len(grid[0])

        from collections import deque
        q = deque()
        q.append((row,col))

        directions = [(-1,0), (1,0), (0, 1), (0, -1)]
        while q:
            r, c = q.popleft()

            for dr, dc in directions:
                nrow = r + dr
                ncol = c + dc

                if 0 <= nrow < n and 0 <= ncol < m and grid[nrow][ncol] == "1" and not visited[nrow][ncol]:
                    visited[nrow][ncol] = 1
                    q.append((nrow, ncol))

        
        
