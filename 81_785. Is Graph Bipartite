81_785. Is Graph Bipartite

class Solution:
    def check(self, start, v, graph, color):
        from collections import deque
        q = deque()
        q.append(start)
        color[start] = 0
        for i in range(v):
            color[i] = -1
        while q:
            node = q.popleft()
            for i in graph[node]:
                #if this is not colored then make it colored
                #else return False
                if color[i] == -1:
                    #make the things colored
                    color[i] = 1 - color[node]
                    q.append(i)
                elif color[i] == color[node]:
                    return False
        return True
    def isBipartite(self, graph: List[List[int]]) -> bool:
        v = len(graph)
        color = [-1] * v
        for i in range(v):
            color[i] = -1
        for i in range(v):
            if color[i] == -1:
                if self.check(i, v, graph, color) == False:
                    return False
        return True
