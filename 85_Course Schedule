85_207. Course Schedule

class Solution:
    def canFinish(self, N: int, prerequisites: List[List[int]]) -> bool:
        adj = [[]for _ in range(N)]
        
        for u,v in prerequisites:
            adj[v].append(u)
        
        #Topological Sort
        indegree = [0]*N
        for i in range(N):
            for j in adj[i]:
                indegree[j] += 1
        
        from collections import deque
        q = deque()
        for i in range(N):
            if indegree[i] == 0:
                q.append(i)
        
        topo = []
        while q:
            node = q.popleft()
            topo.append(node)
            
            for i in adj[node]:
                indegree[i] -= 1
                
                if indegree[i] == 0:
                    q.append(i)
        if len(topo) == N:
            return True
        return False
        
