54_Ceil in BST

''' class Node:
    def __init__(self, val):
        self.right = None
        self.data = val
        self.left = None 
'''
        
class Solution:
    def findCeil(self,root, x):
        # code here
        if root is None:
            return -1
        ceil = -1
        while root:
            if root.data == x:
                ceil = root.data
                return ceil
            if x > root.data:
                root = root.right
            else:
                ceil = root.data
                root = root.left
        return ceil
