71_1343. Number of Sub-arrays of Size K and Average Greater than or Equal to Threshold

class Solution:
    def numOfSubarrays(self, arr: List[int], k: int, threshold: int) -> int:
        n = len(arr)
        count = 0
        summ = 0
        for i in range(k):
            summ += arr[i]
        
        if summ/k >= threshold:
            count += 1
        
        for i in range(k, n):
            summ += arr[i]
            summ -= arr[i-k]

            if summ/k >= threshold:
                count += 1
        return count

