863. All Nodes Distance K in Binary Tree

# Definition for a binary tree node.
# class TreeNode:
#     def __init__(self, x):
#         self.val = x
#         self.left = None
#         self.right = None

class Solution:
    def parentCheck(self, root, parentCheck):
        from collections import deque
        q = deque([root])

        # if it is for add all nodes into queue
        while q:
            current = q.popleft()
            if current.left:
                parentCheck[current.left] = current
                q.append(current.left)
            if current.right:
                parentCheck[current.right] = current
                q.append(current.right)
    def distanceK(self, root: TreeNode, target: TreeNode, k: int) -> List[int]:
        parentTrack = {}
        self.parentCheck(root, parentTrack)

        visited = set()
        q = deque([target])
        visited.add(target)

        currentLevel = 0

        while q:
            size = len(q)
            if currentLevel == k:
                break
            currentLevel += 1

            # for each level check and add into visited and calculate distance
            for _ in range(size):
                current = q.popleft()

                if current.left and current.left not in visited:
                    q.append(current.left)
                    visited.add(current.left)
                
                if current.right and current.right not in visited:
                    q.append(current.right)
                    visited.add(current.right)
                
                if current in parentTrack and parentTrack[current] not in visited:
                    q.append(parentTrack[current])
                    visited.add(parentTrack[current])
        return [node.val for node in q]
        
