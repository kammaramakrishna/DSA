Children Sum in a Binary Tree

'''
# Node Class:
class Node:
    def init(self,val):
        self.data = val
        self.left = None
        self.right = None
'''

class Solution:
    def isSumProperty(self, root):
        # code here
        if root is None:
            return
        child = 0
        #going downwords
        if root.left:
            child += root.left.data
        if root.right:
            child += root.right.data
        
        if child >= root.data:
            root.data = child
        else:
            if root.left:
                root.left.data = root.data
            if root.right:
                root.right.data = root.data
        self.isSumProperty(root.left)
        self.isSumProperty(root.right)
        
        #going upwords
        total = 0
        if root.left:
            total += root.left.data
        if root.right:
            total += root.right.data
        if root.left or root.right:
            root.data = total
