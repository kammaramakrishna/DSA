77_Distance of nearest cell having 1

class Solution:
	def nearest(self, grid):
		# code here
		n = len(grid)
		m = len(grid[0])
		
		from collections import deque
		visited = [[0 for _ in range(m)] for _ in range(n)]
		distance = [[0 for _ in range(m)] for _ in range(n)]
		
		q = deque()
		for i in range(n):
		    for j in range(m):
		        if grid[i][j] == 1:
		            q.append((i,j,0))
		            visited[i][j] = 1
		        else:
		            visited[i][j] = 0
		 
        delRow = [-1, 0, 1, 0]
        delCol = [0, 1, 0, -1]
        
        while q:
            row, col, step = q.popleft()
		     
            distance[row][col] = step
            for i in range(4):
                nrow = row + delRow[i]
                ncol = col + delCol[i]
                if nrow >= 0 and nrow < n and ncol >= 0 and ncol < m and visited[nrow][ncol] == 0:
                    visited[nrow][ncol] = 1
                    q.append((nrow,ncol,step+1))
        return distance
		  
		     
