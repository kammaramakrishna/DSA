82_Directed Graph Cycle


class Solution:
    def dfs(self, node, edges, visited, pathVisited):
        visited[node] = 1
        pathVisited[node] = 1
        
        for i in edges[node]:
            #if the node is not visited
            if not visited[i] == 1:
                if self.dfs(i, edges, visited, pathVisited) == True:
                    return True
            #visited in another path
            #check for pathVisited
            elif pathVisited[i]:
                return True
        pathVisited[node] = 0
        return False
        
    def isCyclic(self, V, edges):
        # code here
        visited = [0]*V
        pathVisited = [0]*V
        
        #convert adj matrix into list
        adj = [[] for _ in range(V)]
        for u, v in edges:
            adj[u].append(v)
        
        for i in range(V):
            if not visited[i]:
                if self.dfs(i, adj, visited, pathVisited) == True:
                    return True
        return False
